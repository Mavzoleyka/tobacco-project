@page "/Reservations/Create"
@model TobaccoWebProject.Pages.Reservations.CreateModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Создание брони";
}

<section class="max-w-lg mx-auto bg-white border-4 border-black p-8 rounded-none shadow-lg mt-10">
    <h1 class="text-3xl font-extrabold uppercase text-center mb-6 text-[#D32F2F]">Создать бронь</h1>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="bg-red-100 text-red-700 p-4 mb-4 border border-red-400">@Model.ErrorMessage</div>
    }

    <form method="post" class="space-y-6">
        <div>
            <label asp-for="Input.PickupDateTime" class="block font-bold mb-2"></label>
            <input asp-for="Input.PickupDateTime" type="datetime-local"
                   value="@DateTime.Now.AddMinutes(30).ToString("yyyy-MM-ddTHH:mm")"
                   class="border border-black p-2 w-full rounded" />
            <span asp-validation-for="Input.PickupDateTime" class="text-red-600 text-sm"></span>
        </div>

        <div>
            <label asp-for="Input.Comment" class="block font-bold mb-2"></label>
            <textarea asp-for="Input.Comment"
                      rows="3"
                      class="w-full border-2 border-black px-3 py-2"></textarea>
            <span asp-validation-for="Input.Comment" class="text-red-600 text-sm"></span>
        </div>

        <button type="submit"
                style="
            background-color: #B71C1C;
            color: white;
            font-weight: 800;
            border: 3px solid black;
            padding: 0.75rem 1rem;
            width: 100%;
            text-transform: uppercase;
            letter-spacing: 2px;
            box-shadow: inset 0 0 0 2px #000;
            transition: all 0.2s ease-in-out;
        "
                onmouseover="this.style.backgroundColor='#D32F2F'"
                onmouseout="this.style.backgroundColor='#B71C1C'">
            Забронировать
        </button>
    </form>
</section>
