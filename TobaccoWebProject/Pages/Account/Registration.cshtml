@page
@using TobaccoWebProject.Pages.Account
@model TobaccoWebProject.Pages.Account.RegistrationModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Регистрация";
}

<div class="max-w-lg mx-auto mt-16 p-10 bg-white border-4 border-black rounded-none shadow-xl">
    <h1 class="text-4xl font-bold uppercase tracking-widest text-center text-[#D32F2F] mb-10">@ViewData["Title"]</h1>

    <form method="post" class="space-y-8">
        <div asp-validation-summary="All" class="text-red-700 mb-4 text-sm"></div>

        <div>
            <label for="Name" class="block text-sm font-bold uppercase tracking-wide text-gray-800 mb-2">Имя пользователя</label>
            <input asp-for="Input.Name" id="Name" type="text"
                   class="w-full border-4 border-black rounded-none px-5 py-3 font-semibold text-gray-900 focus:outline-none focus:ring-4 focus:ring-[#D32F2F] transition" />
            <span asp-validation-for="Input.Name" class="text-red-700 text-xs mt-1 block"></span>
        </div>

        <div>
            <label for="Password" class="block text-sm font-bold uppercase tracking-wide text-gray-800 mb-2">Пароль</label>
            <input asp-for="Input.Password" id="Password" type="password"
                   class="w-full border-4 border-black rounded-none px-5 py-3 font-semibold text-gray-900 focus:outline-none focus:ring-4 focus:ring-[#D32F2F] transition" />
            <span asp-validation-for="Input.Password" class="text-red-700 text-xs mt-1 block"></span>
        </div>

        <div>
            <label for="PasswordAgain" class="block text-sm font-bold uppercase tracking-wide text-gray-800 mb-2">Повторите пароль</label>
            <input asp-for="Input.PasswordAgain" id="PasswordAgain" type="password"
                   class="w-full border-4 border-black rounded-none px-5 py-3 font-semibold text-gray-900 focus:outline-none focus:ring-4 focus:ring-[#D32F2F] transition" />
            <span asp-validation-for="Input.PasswordAgain" class="text-red-700 text-xs mt-1 block"></span>
        </div>

        <button type="submit"
                class="w-full bg-[#D32F2F] text-white border-4 border-black rounded-none uppercase tracking-widest font-bold py-4 shadow-lg hover:bg-[#FFEB3B] hover:text-black hover:border-yellow-400 transition duration-200">
            Зарегистрироваться
        </button>
    </form>

    <div class="mt-10 text-center">
        <p class="text-sm text-gray-800 uppercase tracking-wide">
            Уже есть аккаунт?
            <a href="/Account/Login" class="text-[#D32F2F] hover:underline font-bold">Войти</a>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}