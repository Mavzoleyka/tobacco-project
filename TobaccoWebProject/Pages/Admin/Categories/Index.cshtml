@page
@model TobaccoWebProject.Pages.Admin.Categories.IndexModel
@{
	Layout = "_AdminLayout";
	ViewData["Title"] = "Категории";
}
<div class="container mx-auto px-4 py-10">
    <div class="flex justify-between items-center mb-6">
        <h1 class="text-3xl font-bold">Категории товаров</h1>
        <a asp-page="./Create" class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700">
            + Добавить
        </a>
    </div>

    @if (Model.Categories.Any())
    {
        <table class="w-full border text-left">
            <thead class="bg-gray-100">
                <tr>
                    <th class="py-2 px-4">ID</th>
                    <th class="py-2 px-4">Название</th>
                    <th class="py-2 px-4 text-right">Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var category in Model.Categories)
                {
                    <tr class="border-t">
                        <td class="py-2 px-4">@category.Id</td>
                        <td class="py-2 px-4">@category.Name</td>
                        <td class="py-2 px-4 text-right">
                            <a asp-page="./Edit" asp-route-id="@category.Id"
                               class="text-blue-600 hover:underline">Редактировать</a>
                            <form method="post" asp-page-handler="Delete" asp-route-id="@category.Id" class="inline">
                                <button type="submit"
                                        onclick="return confirm('Удалить категорию?')"
                                        class="text-red-600 hover:underline ml-4">
                                    Удалить
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p class="text-gray-500">Категорий пока нет.</p>
    }
</div>