@page
@model TobaccoWebProject.Pages.Admin.Categories.EditModel
@{
	Layout = "_AdminLayout";
    ViewData["Title"] = "Редактировать категорию";
}

<div class="max-w-lg mx-auto bg-white p-6 rounded shadow">
    <h1 class="text-2xl font-bold mb-4">Редактирование категории</h1>

    <form method="post" class="space-y-4">
        <input type="hidden" asp-for="Input.Id" />
        <div>
            <label asp-for="Input.Name" class="block text-sm font-medium text-gray-700">Название</label>
            <input asp-for="Input.Name" class="mt-1 block w-full border border-gray-300 rounded-md p-2 shadow-sm focus:ring-2 focus:ring-blue-600" />
            <span asp-validation-for="Input.Name" class="text-red-500 text-sm"></span>
        </div>

        <button type="submit"
                class="w-full bg-blue-600 text-white py-2 px-4 rounded hover:bg-blue-700 font-semibold">
            Сохранить изменения
        </button>
    </form>

    <div class="mt-4 text-sm text-gray-600">
        <a asp-page="./Index" class="text-blue-600 hover:underline">← Назад к списку</a>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}