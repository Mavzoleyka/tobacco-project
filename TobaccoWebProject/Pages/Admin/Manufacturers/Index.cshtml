@page "/IndexManufac"
@model TobaccoWebProject.Pages.Admin.Manufacturers.IndexModel
@{
    ViewData["Title"] = "Производители";
    Layout = "_AdminLayout";
}

<div class="container mx-auto px-4 py-10">
    <div class="flex justify-between items-center mb-6">
        <h1 class="text-3xl font-bold">Производители</h1>
        <a asp-page="./Create" class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700">
            + Добавить
        </a>
    </div>

    @if (Model.Manufacturers.Any())
    {
        <table class="w-full border text-left">
            <thead class="bg-gray-100">
                <tr>
                    <th class="py-2 px-4">Название</th>
                    <th class="py-2 px-4">Страна</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Manufacturers)
                {
                    <tr class="border-t">
                        <td class="py-2 px-4">@item.Name</td>
                        <td class="py-2 px-4">@item.Country</td>
                        <td>
                            <a asp-page="./Edit" asp-route-id="@item.Id"
                               class="text-blue-600 hover:underline">Редактировать
                            </a>
                            <a asp-page="./Delete" asp-route-id="@item.Id"
                               class="text-red-600 hover:underline ml-4">Удалить</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p class="text-gray-500">Производителей пока нет.</p>
    }
</div>


