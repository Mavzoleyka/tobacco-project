@page
@model TobaccoWebProject.Pages.Admin.Products.IndexModel
@{
	Layout = "_AdminLayout";
	ViewData["Title"] = "Товары";
}

<div class="container mx-auto px-4 py-10">
    <div class="flex justify-between items-center mb-6">
        <h1 class="text-3xl font-bold">Список товаров</h1>
        <a asp-page="./Create" class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700">
            + Добавить
        </a>
    </div>

    @if (Model.Products.Any())
    {
        <table class="w-full border text-left">
            <thead class="bg-gray-100">
                <tr>
                    <th class="py-2 px-4">Название</th>
                    <th class="py-2 px-4">Бренд</th>
                    <th class="py-2 px-4">Категория</th>
                    <th class="py-2 px-4">Производитель</th>
                    <th class="py-2 px-4 text-right">Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Products)
                {
                    <tr class="border-t">
                        <td class="py-2 px-4">@item.Name</td>
                        <td class="py-2 px-4">@item.Brand</td>
                        <td class="py-2 px-4">@item.CategoryName</td>
                        <td class="py-2 px-4">@item.ManufacturerName</td>
                        <td class="py-2 px-4 text-right">
                            <a asp-page="./Edit" asp-route-id="@item.Id"
                               class="text-blue-600 hover:underline">Редактировать</a>

                            <form method="post" asp-page-handler="Delete" asp-route-id="@item.Id" class="inline">
                                <button type="submit"
                                        onclick="return confirm('Удалить товар?')"
                                        class="text-red-600 hover:underline ml-4">
                                    Удалить
                                </button>
                            </form>
                            <a asp-page="/Admin/Products/Photos/Upload"
                               asp-route-ProductId="@item.Id"
                               class="text-indigo-600 hover:underline ml-4">
                                Загрузить фото
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p class="text-gray-500">Товары пока не добавлены.</p>
    }
</div>