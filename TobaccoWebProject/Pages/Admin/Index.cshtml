@page
@model TobaccoWebProject.Pages.Admin.IndexModel
@{
	ViewData["Title"] = "Панель управления";
    
}

<h1 class="text-3xl font-bold mb-8">Добро пожаловать в панель администратора</h1>

<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    <!-- Производители -->
    <a asp-page="/Admin/Manufacturers/Index"
       class="bg-white shadow rounded-lg p-6 hover:shadow-lg transition block">
        <h2 class="text-xl font-semibold mb-2">🏭 Производители</h2>
        <p class="text-gray-500 text-sm">Добавляйте и редактируйте производителей.</p>
    </a>

    <!-- Категории -->
    <a asp-page="/Admin/Categories/Index"
       class="bg-white shadow rounded-lg p-6 hover:shadow-lg transition block">
        <h2 class="text-xl font-semibold mb-2">🗂 Категории</h2>
        <p class="text-gray-500 text-sm">Управляйте категориями товаров.</p>
    </a>

    <!-- Товары -->
    <a asp-page="/Admin/Products/Index"
       class="bg-white shadow rounded-lg p-6 hover:shadow-lg transition block">
        <h2 class="text-xl font-semibold mb-2">📦 Товары</h2>
        <p class="text-gray-500 text-sm">Добавляйте и редактируйте продукцию.</p>
    </a>
</div>