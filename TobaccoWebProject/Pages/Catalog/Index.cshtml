@page
@model TobaccoWebProject.Pages.Catalog.IndexModel
@{
	Layout = "_Layout";
    ViewData["Title"] = "Каталог";
}

<section class="relative min-h-[60vh] flex items-center justify-center">
    
    <img src="~/images/catalog-bg.png"
         alt="Авангардные полки с пачками"
         class="absolute inset-0 w-full h-full object-cover object-center opacity-70 z-0 select-none pointer-events-none" />

    
    <div class="absolute inset-0 bg-black bg-opacity-20 z-10"></div>

    
    <div class="relative z-20 w-full max-w-6xl mx-auto px-6 py-12">
        <h1 class="text-4xl font-bold text-white mb-8 drop-shadow-lg">Каталог товаров</h1>
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            @foreach (var category in Model.Categories)
            {
                <a asp-page="/Catalog/Category"
                   asp-route-id="@category.Id"
                   class="bg-white shadow rounded-lg p-6 hover:shadow-lg transition block text-center border border-gray-200">
                    <h2 class="text-xl font-semibold mb-2">@category.Name</h2>
                    <p class="text-sm text-gray-500">Смотреть товары →</p>
                </a>
            }
        </div>
    </div>
</section>

