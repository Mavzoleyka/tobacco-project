@page "/ProductCard/{id:int}"
@model TobaccoWebProject.Pages.Catalog.ProductCardModel
@{
	Layout = "_Layout";
	ViewData["Title"] = "Товар";
}

<div class="container mx-auto px-4 py-10">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
        <!-- Галерея -->
        <div>
            <img src="@Url.Content("~/" + Model.MainImage)" alt="@Model.Name"
                 class="rounded shadow-md w-full max-h-[400px] object-contain mb-4" />

            @if (Model.OtherImages.Any())
            {
                <div class="flex gap-4 flex-wrap">
                    @foreach (var img in Model.OtherImages)
                    {
                        <img src="@Url.Content("~/" + img)" alt="Фото"
                             class="w-24 h-24 object-cover border rounded hover:ring-2 ring-blue-400" />
                    }
                </div>
            }
        </div>

        <!-- Инфо -->
        <div>
            <h1 class="text-3xl font-bold mb-2">@Model.Name</h1>
            <p class="text-gray-500 text-sm mb-4">Бренд: @Model.Brand</p>
            <p class="text-gray-500 text-sm mb-4">Производитель: @Model.Manufacturer</p>

            @if (!string.IsNullOrWhiteSpace(Model.Description))
            {
                <p class="mb-6">@Model.Description</p>
            }

            @if (Model.Stock > 0)
            {
                <span class="inline-block px-3 py-1 text-green-800 bg-green-100 rounded-full text-sm font-semibold">
                    В наличии: @Model.Stock
                </span>
            }
            else
            {
                <span class="inline-block px-3 py-1 text-red-800 bg-red-100 rounded-full text-sm font-semibold">
                    Нет в наличии
                </span>
            }

            <div class="mt-6">
                <a asp-page="/Catalog/Category" asp-route-id="@Model.CategoryId"
                   class="text-blue-600 hover:underline text-sm">← Вернуться к категории</a>
            </div>
        </div>
    </div>
</div>